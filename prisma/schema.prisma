generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// PHASE 1 — Pick List / Panels / Change Requests (9 Models)
// ============================================================

model User {
  id             Int       @id @default(autoincrement())
  firstName      String
  lastName       String
  pin            String    // bcrypt hashed, never plaintext
  /** Optional avatar — stored as a data URL (`data:image/webp;base64,...`)
   *  generated client-side from the chosen file, resized down to 256x256
   *  + ~85% webp. Inline-storing avoids any external blob/storage
   *  dependency at the cost of slightly bigger user rows (~30–60 KB). */
  avatarUrl      String?
  /** Free-form personal role / position description (e.g. "A1",
   *  "Comms Tech"). Distinct from ProjectMember.position which scopes
   *  the position to a single show. This is the user's general
   *  identity, surfaced on /profile and (later) suggestable when they
   *  join a new show. */
  position       String?
  /** Free-form department label — Audio, Video, RF, Lighting, Comms,
   *  etc. Same shape as `position` (per-user global default) — kept in
   *  sync with ProjectMember.department whenever a per-show value is
   *  written. Surfaced on /profile and pre-fillable on joins. */
  department     String?
  /** Optional contact email — surfaced on /profile so admins can reach
   *  out about lockouts / scheduling. Not used for auth (PIN-only). */
  email          String?
  /** Optional contact phone — surfaced on /profile for the same reason
   *  as email. Free-form so international formats Just Work. */
  phone          String?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastFailedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  createdProjects   Project[]            @relation("ProjectCreator")
  memberships       ProjectMember[]
  changeRequests    ChangeRequest[]
  accessRequests    AccessRequest[]
  keyDrafts         KeyDraft[]
  nfgReports        NfgReport[]
  pushSubscriptions PushSubscription[]
  panelPresences    PanelPresence[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
}

// Per-user toggle for each notification kind. Drives the settings panel
// on /notifications. Missing row = enabled (default opt-in) — we only
// write a row when the user explicitly disables a type, then flip
// enabled back to true on re-enable. Filter applied in safeSend before
// persistence and push, so an "off" type doesn't even create a history
// row for that user. Other recipients on the same notification still
// receive theirs unaffected.
model NotificationPreference {
  id      Int     @id @default(autoincrement())
  userId  Int
  /** Stable string identifier — see src/lib/notification-types.ts for the catalog. */
  type    String
  enabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

// In-app notification history. One row per recipient per notification
// — written alongside every push send in safeSend(), so the /notifications
// page reflects exactly what the user would have received as a push
// (even if push delivery failed or the device wasn't subscribed yet).
// Read state is per-row; tapping a row marks it read and follows `url`.
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  // Project the notification is scoped to, if any. Drives the per-
  // project filter on /notifications. Nullable so future global-scope
  // notifications (account-level pings, etc.) can stay project-less.
  projectId Int?
  title     String
  body      String?
  url       String?
  tag       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([projectId])
}

// Web Push subscription registered by the user from one device. Stored
// per-endpoint so the same user can subscribe from multiple devices /
// browsers and receive push on all of them. Endpoints are reported by
// the browser as URLs that uniquely identify the destination on the
// browser-vendor's push service (Mozilla / Google / Apple). We dedupe
// on `endpoint` so a re-subscription overwrites instead of duplicating.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  // Web-Push encryption keys reported by the browser when subscribing.
  // Required to encrypt notifications for this endpoint.
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Soft "who's looking at this panel" indicator. One row per (user,
// equipment) pair. Heartbeat-driven: the client posts to refresh
// `lastSeen` every ~10s while the panel is open. Reader queries
// filter on `lastSeen` within the last ~30s — older rows are stale
// and don't appear. No locking — purely informational so a second
// editor knows somebody else is in the room.
model PanelPresence {
  id          Int      @id @default(autoincrement())
  userId      Int
  equipmentId Int
  // 'viewing' or 'editing' — editing fires when the client has
  // unsaved changes to flag a more active state.
  state       String   @default("viewing")
  lastSeen    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([userId, equipmentId])
  @@index([equipmentId, lastSeen])
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  pin         String?  @unique // 4-digit join code, shared with crew
  status      String   @default("active") // active, archived
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Manager-set "brought to the show" totals for panel misc accessories.
  // 0 (default) means "not tracked" — fall back to needed count.
  goosenecksBrought    Int @default(0)
  footswitchesBrought  Int @default(0)
  speakersBrought      Int @default(0)
  // Cable accessories derived from panel footswitch/speaker config.
  // 0 (default) means "not tracked" — fall back to needed count.
  quarterXlrmBrought   Int @default(0) // 1/4" to XLR-M, one per footswitch
  db9XlrfBrought       Int @default(0) // DB9 to XLR-F, one per FS-equipped panel
  rj45XlrmfBrought     Int @default(0) // RJ45 to XLR-M/F, one per speaker
  // When admin activates Return phase, crew see "done" gear as Return tasks
  // alongside the existing Deploy tasks. Toggle on the project edit form.
  returnPhaseActive    Boolean @default(false)

  // Relations
  createdBy      User             @relation("ProjectCreator", fields: [createdById], references: [id])
  members        ProjectMember[]
  pickListItems  PickListItem[]
  changeRequests ChangeRequest[]
  accessRequests AccessRequest[]
  equipment      Equipment[]
  rackTemplates  RackTemplate[]
  headsetInventory ProjectHeadsetInventory[]
  plots          Plot[]
  notifications  Notification[]
  radios         Radio[]
  zones          Zone[]
}

/// Two-way radios tracked per project. Independent table from
/// Equipment because the operational shape is different — radios are
/// checked in/out, scanned via QR/barcode, and tied to a single human
/// at a time. Assignee fields live as snapshots on the row so a
/// radio assigned to someone NOT on the team table still works.
/// `assignedToProjectMemberId` is an optional FK set when the
/// operator picked the name from team-autosuggest; the user-facing
/// "my radio" view prefers the FK over name-matching.
model Radio {
  id           Int       @id @default(autoincrement())
  projectId    Int
  /// Display ID — auto-generated as "RAD 1", "RAD 2"... by bulk add.
  /// Re-uses the new starting-ID generator (letter/dotted/integer
  /// suffix support) shared with the Equipment bulk-create flow.
  name         String
  firstName    String?
  lastName     String?
  department   String?
  position     String?
  /// Free-form barcode/QR scanned off the physical radio
  /// (e.g. `C8098764`). Nullable because admin can pre-create blank
  /// radios via bulk-add and fill the barcode later.
  barcode      String?
  /// True when the radio is currently checked OUT to a person. The
  /// kiosk flow flips this on scan + assignment. checkedOutAt
  /// records when the most recent check-out happened so we can show
  /// "out for 3h" etc. in the kiosk UI later.
  checkedOut   Boolean   @default(false)
  checkedOutAt DateTime?
  /// Accessory flags — yes/no toggles surfaced in the radio edit
  /// card. When true the collapsed row renders a chip for each.
  /// Default false so legacy radios stay accessory-free until an
  /// operator opts in.
  fistMic      Boolean   @default(false)
  surveillance Boolean   @default(false)
  doubleMuff   Boolean   @default(false)
  lightweight  Boolean   @default(false)
  /// Optional link to a ProjectMember. Set when the operator picks
  /// an existing team member from autosuggest; falls back to null
  /// when the radio is assigned to someone not on the team. The
  /// per-radio firstName/lastName fields stay populated either way
  /// so the row reads correctly even after the team membership is
  /// edited or removed.
  assignedToProjectMemberId Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo ProjectMember? @relation(fields: [assignedToProjectMemberId], references: [id], onDelete: SetNull)
  zones      RadioZone[]

  @@index([projectId])
  @@index([assignedToProjectMemberId])
  @@index([projectId, name])
}

/// A zone is a per-project grouping of 16 radio channels. Each zone is
/// rendered as a card (looks like a mult row, no colors) on the Radio
/// Channels tab of /radios. Radios are linked to zones via the
/// RadioZone join table — a radio can belong to multiple zones, and on
/// /my-equipment the assigned holder sees every zone their radio is
/// in with its channel names.
model Zone {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  /// Display order on the Radio Channels tab. Lower = top.
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channels ZoneChannel[]
  radios   RadioZone[]

  @@index([projectId])
}

/// One slot in a zone's 16-channel grid. `channelIndex` is 1..16,
/// unique within a zone so we always render in numeric order. `name`
/// stays nullable for slots the admin hasn't filled in yet — the
/// createZone action seeds all 16 rows empty so the UI has stable IDs
/// for in-place editing without dancing around missing rows.
model ZoneChannel {
  id           Int     @id @default(autoincrement())
  zoneId       Int
  channelIndex Int
  name         String?

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, channelIndex])
  @@index([zoneId])
}

/// Many-to-many between Radio and Zone. A single radio can ride
/// multiple zones (`if their 2 zones display the name there as well`)
/// so each row is a single radio↔zone link. Composite PK keeps the
/// link unique without a useless surrogate id.
model RadioZone {
  radioId Int
  zoneId  Int

  radio Radio @relation(fields: [radioId], references: [id], onDelete: Cascade)
  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([radioId, zoneId])
  @@index([zoneId])
}

// Per-project stage plots. Stores a label + external URL (typically a
// Google Drive share link). The PDF itself lives wherever the URL
// points — Nodal just remembers the pointer per project.
model Plot {
  id        Int      @id @default(autoincrement())
  projectId Int
  label     String
  url       String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectHeadsetInventory {
  id          Int     @id @default(autoincrement())
  projectId   Int
  headsetType String
  brought     Int     @default(0)
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, headsetType])
  @@index([projectId])
}

model ProjectMember {
  id           Int     @id @default(autoincrement())
  userId       Int
  projectId    Int
  role         String  // admin, manager, crew, user
  position     String? // e.g. PLHQ, A1, A2
  /** Per-show department label — e.g. Audio, Video, RF, Lighting,
   *  Comms. Free-form so users can put whatever the production crew
   *  actually calls things. Separate from position because the same
   *  person might be "A1" (position) in "Audio" (department). */
  department   String?
  location     String? // e.g. FOH, MON, STAGE
  hardwareType String? // e.g. RSP-1232, Bolero
  ipAddress    String?
  headsetType  String? // e.g. 4 LWHS, DT290
  deployStatus String  @default("na") // deployed, done, returned, not-needed, damaged, na
  riedelId     Int?

  // Relations
  user            User              @relation(fields: [userId], references: [id])
  project         Project           @relation(fields: [projectId], references: [id])
  panelKeys       PanelKey[]
  equipment       Equipment[]
  changeRequests  ChangeRequest[]   @relation("ChangeRequestTarget")
  radios          Radio[]

  @@unique([userId, projectId])
}

model PickListItem {
  id        Int     @id @default(autoincrement())
  projectId Int
  code      String? // Human-readable code: C001 (CONF), IF01 (IFB), G001 (GRP), A001 (Audio_IO)
  name      String  // Function name
  type      String  // PTP, CONF, IFB, Audio_IO, GRP

  // Relations
  project   Project    @relation(fields: [projectId], references: [id])
  panelKeys PanelKey[]
  keyDrafts KeyDraft[]
}

model PanelKey {
  id              Int    @id @default(autoincrement())
  projectMemberId Int
  // Equipment dimension — keys are scoped to a single panel-category
  // device (panels / hardwire_bp / wireless_bp). Members with multiple
  // devices on a project get one PanelKey row per device per slot.
  equipmentId     Int
  keyIndex        Int    // Physical key position
  page            String @default("main") // main, shift
  expansion       Int    @default(0) // 0 = main panel, 1-6 = expansion
  pickListItemId  Int?
  triggerMode     String @default("latch") // latch, momentary, auto
  talkMode        String @default("tl") // tl = Talk/Listen, t = Talk only, l = Listen only

  // Relations
  projectMember      ProjectMember       @relation(fields: [projectMemberId], references: [id])
  equipment          Equipment           @relation(fields: [equipmentId], references: [id])
  pickListItem       PickListItem?       @relation(fields: [pickListItemId], references: [id])
  keyDrafts          KeyDraft[]
  changeRequestItems ChangeRequestItem[]

  @@unique([equipmentId, keyIndex, page, expansion])
  @@index([projectMemberId])
}

model KeyDraft {
  id             Int      @id @default(autoincrement())
  panelKeyId     Int
  editedById     Int
  pickListItemId Int?
  triggerMode    String?
  talkMode       String?
  status         String   @default("draft") // draft, submitted
  createdAt      DateTime @default(now())

  // Relations
  panelKey     PanelKey      @relation(fields: [panelKeyId], references: [id])
  editedBy     User          @relation(fields: [editedById], references: [id])
  pickListItem PickListItem? @relation(fields: [pickListItemId], references: [id])
}

model ChangeRequest {
  id             Int       @id @default(autoincrement())
  projectId      Int
  submittedById  Int
  targetMemberId Int
  // Equipment scope — every ChangeRequest is scoped to ONE panel-category
  // device. Multi-device members produce one ChangeRequest per device so
  // admins see a separate review card per device, not a combined card.
  equipmentId    Int
  status         String    @default("draft") // draft, submitted, mgr_endorsed, approved, rejected, applied, discarded
  rejectionNote  String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  // Relations
  project      Project             @relation(fields: [projectId], references: [id])
  submittedBy  User                @relation(fields: [submittedById], references: [id])
  targetMember ProjectMember       @relation("ChangeRequestTarget", fields: [targetMemberId], references: [id])
  equipment    Equipment           @relation(fields: [equipmentId], references: [id])
  items        ChangeRequestItem[]

  @@index([equipmentId])
}

model ChangeRequestItem {
  id              Int    @id @default(autoincrement())
  changeRequestId Int
  panelKeyId      Int
  fieldChanged    String
  previousValue   String?
  newValue        String?

  // Relations
  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id])
  panelKey      PanelKey      @relation(fields: [panelKeyId], references: [id])
}

model AccessRequest {
  id         Int       @id @default(autoincrement())
  userId     Int
  projectId  Int
  status     String    @default("pending") // pending, approved, rejected
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
}

// ============================================================
// PHASE 2-4 — Equipment / Assets / Racks / NFG (5 Models)
// ============================================================

model Equipment {
  id           Int     @id @default(autoincrement())
  projectId    Int
  assignedToId Int?
  name         String  // Auto-generated identifier e.g. PNL 1, WLBP 1, SW 1, FBR A
  category     String  // panels, wireless_bp, hardwire_bp, switches, antennas, audio, mults
  hardwareType String?
  position     String?
  location     String?
  headsetType  String?
  ipAddress    String?
  patch        String? // Patch label (switches only)
  deployStatus String  @default("na") // deployed, done, returned, not-needed, damaged, na
  notes        String?
  assetId      Int?
  // Panel-only misc accessories (default off for all categories)
  gooseneck    Boolean @default(false)
  footswitches Int     @default(0)
  speakers     Int     @default(0)
  // Mult-only: the switch / Pliant antenna this mult plugs INTO at
  // its trunk end. Multiple mults can trunk into the same device.
  trunkEquipmentId Int?
  // Mult-only: number of strands/pairs. Fiber is variable (chosen at
  // create time: 2/4/12/24/48/76); Ethernet/W1/CPC are fixed at
  // 5/16/4 but stored here too for consistency.
  strandCount  Int?
  // Mult-only: physical length in feet (25 / 50 / 100 / 150 / 300 /
  // 500 / 1000). Stored as an int so we can sort + filter; rendered
  // with a trailing apostrophe in the UI.
  lengthFeet   Int?

  // Relations
  project         Project         @relation(fields: [projectId], references: [id])
  assignedTo      ProjectMember?  @relation(fields: [assignedToId], references: [id])
  asset           Asset?          @relation(fields: [assetId], references: [id])
  nfgReports      NfgReport[]
  panelKeys       PanelKey[]
  changeRequests  ChangeRequest[]
  panelPresences  PanelPresence[]
  // Mult relations — when this row IS a mult, it has strands. When
  // another mult trunks into THIS row (e.g. switch / Pliant antenna),
  // those mults show up in trunkingMults.
  trunkEquipment  Equipment?      @relation("MultTrunk", fields: [trunkEquipmentId], references: [id])
  trunkingMults   Equipment[]     @relation("MultTrunk")
  strands         MultStrand[]    @relation("MultStrands")
  attachedStrands MultStrand[]    @relation("StrandAttachment")
}

// One row per strand/pair on a mult. The mult itself lives in
// Equipment (category='mults'); its strands live here so we can
// query individual strand wiring across the project.
model MultStrand {
  id                  Int    @id @default(autoincrement())
  // The Equipment row (category='mults') this strand belongs to.
  multEquipmentId     Int
  // 1-based strand/pair index inside the mult.
  index               Int
  // Free-text channel name the user types ("FOH Mix", "Wireless A return").
  channelName         String @default("")
  // What's attached on the FAR end. Nullable — pairs on W1 / CPC
  // mults are documentation only and stay null.
  attachedEquipmentId Int?

  mult     Equipment  @relation("MultStrands", fields: [multEquipmentId], references: [id], onDelete: Cascade)
  attached Equipment? @relation("StrandAttachment", fields: [attachedEquipmentId], references: [id], onDelete: SetNull)

  @@unique([multEquipmentId, index])
  @@index([attachedEquipmentId])
}

model Asset {
  id           Int      @id @default(autoincrement())
  qrCode       String   @unique
  hardwareType String
  serialNumber String
  owner        String   // e.g. Clair Global
  status       String   @default("active") // active, retired, repair
  createdAt    DateTime @default(now())

  // Relations
  equipment  Equipment[]
  nfgReports NfgReport[]
}

model RackTemplate {
  id          Int     @id @default(autoincrement())
  name        String  // e.g. FS11, Bolero, Bolero to Helixnet
  description String?
  totalRU     Int
  type        String  // standard, custom
  projectId   Int?

  // Relations
  project Project?   @relation(fields: [projectId], references: [id])
  slots   RackSlot[]
}

model RackSlot {
  id             Int    @id @default(autoincrement())
  rackTemplateId Int
  ruPosition     Int    // Starting RU position (top = 1)
  ruSize         Int    // Height in RU
  side           String // front, rear
  deviceType     String // e.g. Artist-64 Frame, Antaira Switch
  label          String
  color          String?

  // Relations
  rackTemplate RackTemplate @relation(fields: [rackTemplateId], references: [id])
}

model NfgReport {
  id           Int       @id @default(autoincrement())
  equipmentId  Int
  assetId      Int?
  reportedById Int
  notes        String
  status       String    @default("open") // open, acknowledged, resolved
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  // Relations
  equipment  Equipment @relation(fields: [equipmentId], references: [id])
  asset      Asset?    @relation(fields: [assetId], references: [id])
  reportedBy User      @relation(fields: [reportedById], references: [id])
}
